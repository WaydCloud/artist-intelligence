# --- 시크릿 / 자격증명 (절대 커밋 금지) ---
.env
.env.*
!.env.example
*.key
.mcp.local.json

# --- 개인 자료 (공개 포트폴리오 repo에 안 올라가게) ---
# 로컬에만 보관. 비공개 버전관리를 원하면 이 줄을 제거.
personal/

# --- 대용량 미디어 (파생 결과만 커밋) ---
modules/*/data/
# 스냅샷 store(collect 랜딩존, RULES chart-history §4.3) — 재현 소스는 tests/fixtures/
data/snapshots/
# 라이브 수집 store(signal-bridge 실증 랜딩존) — 커밋 소스는 tests/fixtures/chart_live_kr/
data/live/
*.mp4
*.mov
*.wav
*.m4a

# --- Python ---
__pycache__/
*.pyc
.venv/
.uv/

# --- Node / Next.js ---
node_modules/
.next/
dist/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- 에이전트 스킬 (npx skills) ---
# 실물은 `.agents/skills/`에 두고 커밋한다(벤더링 관행 · LICENSE 동봉).
# `.claude/skills/` 아래 같은 이름은 설치기가 만든 **심링크**라 커밋하지 않는다 —
# 이 저장소는 core.symlinks=false이고 기존 심링크가 0개다. 커밋하면 Windows 체크아웃에서
# 경로 문자열이 든 일반 파일로 풀려 스킬이 조용히 사라진다. 클론 뒤 `npx skills add`가
# 이 심링크만 다시 만든다(내용은 이미 저장소에 있다).
.claude/skills/supabase
.claude/skills/supabase-postgres-best-practices

# --- OS ---
.DS_Store
Thumbs.db

# 사전학습 모델 (런타임 페치, CC BY-NC-SA — 재배포 금지)
data/models/

# 조사용 분석 캐시 — 엔진 키가 바뀌면 통째로 무효화되는 파생물이라 커밋 대상이 아니다.
# (관측 이력이 캐시에 얹혀 있으면 안 된다 — HANDOFF "트랙 원장 설계안" 참조)
data/research/**/cache*.json

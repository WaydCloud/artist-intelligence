{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-intelligence/signal-series.schema.json",
  "title": "SignalSeries",
  "description": "모듈 간 시계열 공유 규격 — snapshot-schema(수집물)·report-schema(산출물)의 짝. 각 소스 모듈의 `signals` 서브커맨드가 방출하고 signal-bridge가 소비한다. 정본 서술은 modules/signal-bridge/SPEC.md §signal-series 데이터 계약이며, 이 파일은 그 기계검증형이다. 시리즈 길이=dates 길이·dates 정렬 등 스키마가 못 잡는 일관성은 scripts/validate_series.py가 마저 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "signal", "unit", "higherIsStronger", "dates", "series", "roster", "provenance"],
  "properties": {
    "moduleId": { "type": "string", "minLength": 1, "description": "발신 모듈 id (예: 'fandom-pulse')" },
    "signal": {
      "type": "string",
      "minLength": 1,
      "description": "신호 종류. 알려진 값: social-buzz(fandom-pulse) · chart-rank(chart-history) · yt-velocity(yt-pulse). 역할 검증(어느 입력에 어느 신호)은 브리지가 수행 — 스키마는 봉투만 본다."
    },
    "unit": { "type": "string", "minLength": 1, "description": "사람이 읽는 단위 (예: 'posts/day', 'rank (lower=stronger)'). 무단위 지표도 축을 적는다(예: '0-1')." },
    "higherIsStronger": { "type": "boolean", "description": "신호 방향 (social=true, chart-rank=false)" },
    "dates": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "uniqueItems": true,
      "description": "정렬된 ISO 일자 (이 모듈의 관측 창). 정렬 여부는 validate_series.py가 검사."
    },
    "series": {
      "type": "object",
      "description": "캐노니컬 키(entity-master) → dates에 정렬된 값. null = 그날 신호 없음(차트 밖 등).",
      "additionalProperties": {
        "type": "array",
        "items": { "type": ["number", "null"] }
      }
    },
    "roster": {
      "type": "object",
      "description": "캐노니컬 키가 추적 유니버스(entities+watchlist)에 매치되는가. 미매치(false)도 조인에서 살아남아 pre-mainstream 관측대상이 된다.",
      "additionalProperties": { "type": "boolean" }
    },
    "provenance": {
      "type": "object",
      "description": "출처·생성 시각·관측 창. 모듈별 부가 맥락(hashtag·marketCount 등)은 자유 — 추궁 가능성의 전제(DOMAIN §0)이므로 핵심 3필드만 강제한다.",
      "required": ["source", "generatedAt", "window"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "minLength": 1 },
        "window": { "type": "string", "description": "'YYYY-MM-DD..YYYY-MM-DD' (빈 시리즈면 빈 문자열)" },
        "synthetic": { "type": "boolean", "description": "소스가 합성 픽스처(tos_class=synthetic-fixture)면 true — 브리지가 메커니즘 시연 경고를 낸다(§0)" },
        "reconstructed": { "type": "boolean", "description": "라이브 스냅샷의 Days로 진입일 역산한 회고 시리즈면 true" },
        "marketCount": { "type": "integer", "minimum": 0 },
        "platformCount": { "type": "integer", "minimum": 0 },
        "platformFirstDates": {
          "type": "object",
          "description": "플랫폼 → 그 렌즈의 첫 관측일 — 브리지의 렌즈 시차 좌측 절단 보정용(D-016 ②)",
          "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "entered_before_window": { "type": "integer", "minimum": 0 },
        "hashtag": { "type": "string" },
        "attribution": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "engagement": {
      "type": "object",
      "description": "social만(D-013): act별 likes+comments 합 ('얼마나')",
      "additionalProperties": { "type": "number" }
    },
    "drivers": {
      "type": "object",
      "description": "social만(D-013): act별 귀속 근거 상위 사운드·태그 ('왜')",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sounds", "tags"],
        "properties": {
          "sounds": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "markets": {
      "type": "object",
      "description": "chart만(D-013): act별 진입 시장 ('어디')",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "platforms": {
      "type": "object",
      "description": "chart만(D-016): act별 진입 플랫폼. rank는 플랫폼 혼합 최고순위(진입 온셋용, 절대비교 금지)",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "platformOnsets": {
      "type": "object",
      "description": "chart만(D-016 ②): act → 플랫폼 → 그 렌즈 첫 관측일",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "subscribers": {
      "type": "object",
      "description": "yt만: act별 채널 구독자 수",
      "additionalProperties": { "type": "number" }
    },
    "videos": {
      "type": "object",
      "description": "yt만: act별 대표 최근작(제목·조회·평균 일 조회·게시일)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "views", "avg_daily", "published_at"],
        "properties": {
          "title": { "type": "string" },
          "views": { "type": "number", "minimum": 0 },
          "avg_daily": { "type": "number", "minimum": 0 },
          "published_at": { "type": "string" }
        }
      }
    }
  }
}
